+/*
+ * ftsCore.c:85 fts_system_reset: the board has a reset gpio, so the vendor
+ * path is a 10 ms low pulse, not a write to ADDR_SYSTEM_RESET; after it the
+ * driver polls for EVT_ID_CONTROLLER_READY (0x03), up to RETRY_SYSTEM_RESET
+ * (3) times. Then the application is up again and is asked for its id, the
+ * interrupt is enabled (ftsHardware.h: ADDR_IER <- IER_ENABLE 0x41) and
+ * scanning is switched on with FTS_CMD_SCAN_MODE (ftsCore.c:setScanMode).
+ * ADDR_BOOT_OPTION is defined by the reference but never written, and
+ * nothing here touches the firmware or the flash.
+ */
+static bool
+ftm5_init(uint8_t *high, uint8_t *low)
+{
+	uint8_t fw[2] = { 0, 0 };
+	uint8_t ier = FTM5_IER_ENABLE, ier_back = 0;
+	bool ready = false, ok;
+
+	if (reset_mode == 2) {
+		printf("UMI TOUCH: FTM5 reset skipped (umi_touch_reset=2)\n");
+	} else {
+		for (unsigned attempt = 0; attempt < 3 && !ready; attempt++) {
+			gpio_output(PIN_RESET, false, PULL_NONE, 2);
+			umi_spin_ms(10);
+			gpio_output(PIN_RESET, true, PULL_NONE, 2);
+			ready = ftm5_wait_event(FTM5_EVENTID_CONTROLLER_READY, 500);
+			printf("UMI TOUCH: FTM5 reset %u: controller ready %s\n",
+			    attempt + 1, ready ? "seen" : "not seen");
+		}
+	}
+	if (!ftm5_check_id("after reset", high, low)) {
+		return false;
+	}
+	(void)fts_read_registers(FTM5_ADDR_DCHIP_FW_VER, fw, sizeof(fw));
+	printf("UMI TOUCH: FTM5 id %02x %02x, fw %02x %02x at 0x%08x "
+	    "(application running)\n", *high, *low, fw[0], fw[1],
+	    FTM5_ADDR_DCHIP_FW_VER);
+
+	ok = fts_write_registers(FTM5_ADDR_IER, &ier, 1);
+	(void)fts_read_registers(FTM5_ADDR_IER, &ier_back, 1);
+	printf("UMI TOUCH: FTM5 IER 0x%08x <- 0x%02x: %s, read back %02x\n",
+	    FTM5_ADDR_IER, ier, ok ? "acked" : "not acked", ier_back);
+
+	{
+		uint8_t scan[3] = { FTM5_CMD_SCAN_MODE, FTM5_SCAN_MODE_ACTIVE,
+		    (uint8_t)scan_mode };
+
+		printf("UMI TOUCH: FTM5 scan mode %02x %02x: %s\n", scan[1], scan[2],
+		    fts_write_bytes(scan, sizeof(scan)) ? "acked" : "not acked");
+	}
+	/* Whatever the reset left in the FIFO is not a finger. */
+	for (unsigned i = 0; i < FTS_FIFO_DEPTH; i++) {
+		uint8_t events[FTS_EVENT_SIZE];
+
+		if (!fts_read_events_ftm5(events, 1) ||
+		    events[0] == EVENTID_NO_EVENT) {
+			break;
+		}
+	}
+	umi_spin_ms(20);
+	return true;
+}
