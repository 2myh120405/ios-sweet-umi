+/*
+ * One FTM5 touch event (ftsSoftware.h:273-281, the FTS5 event format):
+ *   event[0]  0x13 enter, 0x23 motion, 0x33 leave
+ *   event[1]  [7:4] touch id, [3:0] touch type (1 finger, 3 stylus, 5 hover)
+ *   event[2]  x bits 7..0
+ *   event[3]  [3:0] x bits 11..8, [7:4] y bits 11..8
+ *   event[4]  y bits 7..0
+ *   event[5]  pressure, [6]/[7] major/minor -- not needed to move a cursor
+ * Coordinates are 12-bit panel pixels (0..1079, 0..2339).
+ */
+static void
+parse_event_ftm5(const uint8_t *event)
+{
+	uint32_t id = (event[1] & 0xf0) >> 4;
+	uint32_t type = event[1] & FTM5_TOUCH_TYPE_MASK;
+	uint32_t x = (((uint32_t)event[3] & 0x0f) << 8) | event[2];
+	uint32_t y = ((uint32_t)event[4] << 4) | ((event[3] & 0xf0) >> 4);
+	bool down = event[0] != FTM5_EVENTID_LEAVE_POINTER;
+
+	if (down && type == FTM5_TOUCH_TYPE_HOVER) {
+		return;                 /* a hover is not a touch */
+	}
+	seen.reports++;
+	if (umi_events) {
+		printf("UMI TOUCH: event %02x %02x %02x %02x %02x %02x %02x %02x"
+		    " -> id %u type %u %s x %u y %u\n",
+		    event[0], event[1], event[2], event[3], event[4],
+		    event[5], event[6], event[7], id, type,
+		    down ? "down" : "up", x, y);
+	}
+	report_touch(id, down, x, y);
+}
