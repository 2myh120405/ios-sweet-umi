 static void
 poll_report(void)
 {
+	uint8_t events[FTM5_EVENT_BURST_MAX * FTS_EVENT_SIZE];
 	uint8_t event[FTS_EVENT_SIZE];
 	static unsigned shown_raw;
 
 	seen.polls++;
 	/*
-	 * Drain the FIFO: the chip queues one event per finger per change, up to
-	 * FIFO_DEPTH, and 0x00 means empty. Reading one event per look and
-	 * stopping would leave a queue behind and the touch would lag.
+	 * FTM5: one 0x86 transaction brings back a burst of events. The chip
+	 * queues one event per finger per change, up to FIFO_DEPTH, and 0x00
+	 * means empty. Ask again while a whole burst came back, so a queue left
+	 * by a slow poll does not become lag.
+	 */
+	if (!umi_legacy) {
+		for (unsigned round = 0; round < 4; round++) {
+			bool full = true;
+
+			if (!fts_read_events_ftm5(events, events_burst)) {
+				seen.bad++;
+				return;
+			}
+			for (unsigned i = 0; i < events_burst; i++) {
+				const uint8_t *e = &events[i * FTS_EVENT_SIZE];
+
+				if (e[0] == EVENTID_NO_EVENT) {
+					full = false;
+					break;
+				}
+				switch (e[0]) {
+				case FTM5_EVENTID_ENTER_POINTER:
+				case FTM5_EVENTID_MOTION_POINTER:
+				case FTM5_EVENTID_LEAVE_POINTER:
+					parse_event_ftm5(e);
+					break;
+				default:
+					if (umi_events) {
+						printf("UMI TOUCH: event %02x %02x %02x %02x "
+						    "%02x %02x %02x %02x (not a touch)\n",
+						    e[0], e[1], e[2], e[3], e[4],
+						    e[5], e[6], e[7]);
+					}
+					break;
+				}
+			}
+			if (!full) {
+				return;
+			}
+		}
+		return;
+	}
+	/*
+	 * Legacy 0xB6/0x85: one event per transaction, 0x00 means empty.
 	 */
