 /*
+ * ftsCore.c:188 pollForEvent, reduced to "wait for one event id": read one
+ * event at a time until the wanted id comes back or the timeout expires.
+ */
+static bool
+ftm5_wait_event(uint8_t wanted, uint32_t timeout_ms)
+{
+	uint8_t events[FTS_EVENT_SIZE];
+
+	for (uint32_t i = 0; i < timeout_ms; i++) {
+		if (fts_read_events_ftm5(events, 1) && events[0] == wanted) {
+			return true;
+		}
+		umi_spin_ms(1);
+	}
+	return false;
+}
+
+static bool
+ftm5_check_id(const char *when, uint8_t *high, uint8_t *low)
+{
+	uint8_t id[2] = { 0, 0 };
+
+	if (!fts_read_registers(FTM5_ADDR_DCHIP_ID, id, sizeof(id))) {
+		printf("UMI TOUCH: FTM5 id %s: not acknowledged\n", when);
+		return false;
+	}
+	if (id[0] != FTM5_ID_0 || id[1] != FTM5_ID_1) {
+		printf("UMI TOUCH: FTM5 id %s: %02x %02x at 0x%08x, expected %02x %02x\n",
+		    when, id[0], id[1], FTM5_ADDR_DCHIP_ID, FTM5_ID_0, FTM5_ID_1);
+		return false;
+	}
+	*high = id[0];
+	*low = id[1];
+	return true;
+}
