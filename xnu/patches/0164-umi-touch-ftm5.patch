+/*
+ * FTM5 event read: command 0x86 (FIFO_CMD_READALL), repeated start, then
+ * count * FIFO_EVENT_SIZE bytes, no address and no dummy byte
+ * (ftsCore.c:196-207; ftsHardware.h FIFO_CMD_READALL and FIFO_EVENT_SIZE for
+ * I2C_INTERFACE). The answer is min(pending, count) events; an event whose
+ * first byte is 0x00 means the FIFO had nothing more.
+ */
+static bool
+fts_read_events_ftm5(uint8_t *events, uint32_t count)
+{
+	uint32_t total;
+	bool ok = false;
+
+	if (count == 0 || count > FTM5_EVENT_BURST_MAX) {
+		return false;
+	}
+	total = count * FTS_EVENT_SIZE;
+	memset(events, 0, total);
+	i2c_ack_reset();
+	i2c_start();
+	if (i2c_write_byte((uint8_t)(I2C_ADDRESS << 1)) &&
+	    i2c_write_byte(FTM5_CMD_READ_ALL)) {
+		i2c_start();
+		if (i2c_write_read_address()) {
+			for (uint32_t i = 0; i < total; i++) {
+				events[i] = i2c_read_byte(i + 1 < total);
+			}
+			ok = true;
+		}
+	}
+	i2c_stop();
+	return ok;
+}
