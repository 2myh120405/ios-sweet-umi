+/* FTM5 write: {0xFA, address[4], data ...} in one transaction
+ * (ftsIO.c:fts_writeU8UX with BITS_32). */
+static bool
+fts_write_registers_ftm5(uint32_t address, const uint8_t *data, uint32_t length)
+{
+	bool ok;
+
+	i2c_ack_reset();
+	i2c_start();
+	ok = i2c_write_byte((uint8_t)(I2C_ADDRESS << 1)) &&
+	    i2c_write_byte(FTM5_CMD_HW_REG) &&
+	    i2c_write_byte((uint8_t)(address >> 24)) &&
+	    i2c_write_byte((uint8_t)(address >> 16)) &&
+	    i2c_write_byte((uint8_t)(address >> 8)) &&
+	    i2c_write_byte((uint8_t)(address));
+	for (uint32_t i = 0; ok && i < length; i++) {
+		ok = i2c_write_byte(data[i]);
+	}
+	i2c_stop();
+	return ok;
+}
