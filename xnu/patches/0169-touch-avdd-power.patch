@@ -12,8 +12,9 @@
 
 extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
 int sweet_rpmh_vreg_enable(const char *res, unsigned mv);
 int sweet_rpmh_vreg_set(const char *res, unsigned mv, unsigned enable);
+int sweet_rpmh_vreg_set_addr(uint32_t address, unsigned mv, unsigned enable);
 
 /* Live downstream DT has two positional reg entries, no reg-names. */
 #define RH_RSC_PA       0x18220000u
 #define RH_TCS_PA       0x18220d00u
@@ -413,9 +414,17 @@
 		{ "ldoc11", 2950, 3400 },
 		{ "ldoc1",  1700, 1900 },
 		{ "smpa4",  1700, 1900 },
 		{ "smpa5",  1700, 1900 },
-		{ "ldo13",  2800, 3300 },      /* pm8150_l13: the umi touch analog rail (avdd, 3.0 V) */
+		/*
+		 * pm8150_l13, the umi touch analog rail (avdd, 3.008 V fixed).
+		 * cmd-db does not key regulators by their DT label: rpmh-regulator
+		 * builds "ldo" + the PMIC's qcom,pmic-id + index, and PM8150's id
+		 * is "a", so the key is "ldoa13" (kona-regulators.dtsi spells the
+		 * same thing out as qcom,resource-name = "ldoa13").  "ldo13" is
+		 * not a key in any cmd-db and can only ever return ENODEV.
+		 */
+		{ "ldoa13", 2800, 3300 },
 	};
 	unsigned lo = 0, hi = 0;
 
 	if (!res) {
@@ -458,5 +467,43 @@
 	}
 	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
 	return error;
 }
+
+/*
+ * Raw-address vote for a rail that rpmh knows but cmd-db does not carry under
+ * the name Linux derives.  The cmd-db slot of a VRM resource is assigned by
+ * the boot firmware, not by the PMIC number, so the only way to learn it for a
+ * key that is missing is the sweet_rpmh_dump=1 table.  Once that number is
+ * known, umi_touch_avdd_addr=<addr> places the same voltage/enable/mode vote
+ * without going through rh_lookup(); the address shape check below is the one
+ * rh_lookup() already applies to every cmd-db entry.
+ */
+int
+sweet_rpmh_vreg_set_addr(uint32_t address, unsigned mv, unsigned enable)
+{
+	int error;
+
+	if ((address >> 16) != RH_VRM || (address & 15u) || mv > 4000) {
+		printf("SWEET RPMH: refusing raw VRM address %#x / %u mV\n", address, mv);
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	error = EIO;
+	if (rh_poisoned) {
+		printf("SWEET RPMH: previous uncertain transaction; refusing further access\n");
+		goto out;
+	}
+	error = rh_map();
+	if (!error) {
+		error = rh_send(address, mv, enable);
+	}
+out:
+	if (error) {
+		printf("SWEET RPMH: raw enable failed errno=%d\n", error);
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
 #endif /* ARM64_BOARD_CONFIG_SWEET */
