+static IOReturn
+sweet_fb_get_block(IOExternalMethodArguments *args)
+{
+	uint64_t block = args->scalarInputCount > 0 ? args->scalarInput[0] : 0;
+	bool descriptor = args->structureOutputDescriptor != NULL;
+	uint32_t n = (uint32_t)(descriptor ? args->structureOutputDescriptor->getLength()
+	                                  : args->structureOutputSize);
+	uint8_t *buf;
+	IOReturn ret = kIOReturnSuccess;
+
+	if (n == 0) {
+		return kIOReturnSuccess;
+	}
+	if (n > 4096) {
+		return kIOReturnBadArgument;
+	}
+	if (!descriptor && args->structureOutput == NULL) {
+		return kIOReturnBadArgument;
+	}
+	if (descriptor) {
+		buf = (uint8_t *)IOMallocData(n);
+		if (buf == NULL) {
+			return kIOReturnNoMemory;
+		}
+	} else {
