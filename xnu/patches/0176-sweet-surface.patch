+/*
+ * IOSurfaceIncrementUseCount / DecrementUseCount.  The counter lives in the
+ * shared state page at +0x18 (two 32-bit categories, category 1 in the high
+ * half), which is what IOSurfaceIsInUse() and a client's drawable recycling
+ * read.  Counts are per view and leave with it in SweetSurfaceRef::free().
+ */
+IOReturn
+IOSurfaceRootUserClient::trapUseCount(void *id, void *category, int delta)
+{
+	uint32_t sid = (uint32_t)(uintptr_t)id;
+	uint32_t cat = (uint32_t)(uintptr_t)category;
+	SweetSurface *s = sweet_surface_held(fLock, fRefs, sid);
+	IOReturn ret = kIOReturnSuccess;
+	uint32_t now = 0;
+
+	if (s == NULL) {
+		return kIOReturnNotFound;
+	}
+	if (cat > 1) {
+		s->release();
+		ret = kIOReturnBadArgument;
+		sweet_trap_trace(delta > 0 ? 0 : 1, sid, cat, 0, ret);
+		return ret;
+	}
+	if (!sweet_surface_modern_on) {
+		/* Baseline behaviour: the call succeeds, the page is not touched. */
+		s->release();
+		sweet_trap_trace(delta > 0 ? 0 : 1, sid, cat, 0, kIOReturnSuccess);
+		return kIOReturnSuccess;
+	}
+	IOLockLock(fLock);
+	SweetSurfaceRef *ref = findRef(sid, NULL);
+	if (ref == NULL) {
+		ret = kIOReturnNotFound;
+	} else if (delta > 0 || ref->use[cat] != 0) {
+		ref->use[cat] += (uint32_t)delta;
+		IOLockLock(sweet_surface_lock);
+		if (delta > 0 || s->useCount[cat] != 0) {
+			s->useCount[cat] += (uint32_t)delta;
+		}
+		sweet_surface_store_uses_locked(s);
+		IOLockUnlock(sweet_surface_lock);
+		now = ref->use[cat];
+	}
+	IOLockUnlock(fLock);
+	s->release();
+	sweet_trap_trace(delta > 0 ? 0 : 1, sid, cat, now, ret);
+	return ret;
+}
