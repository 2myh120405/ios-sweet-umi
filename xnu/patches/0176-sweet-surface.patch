+		IOLog("SWEET FB: GetBlock block=0x%llx n=%u color=%u timing=%u -> 0x%x n=%llu\n",
+		    block, n, SWEET_FB_COLOR_ID, SWEET_FB_TIMING_ID, ret, fbGetBlockN);
+	}
