+/*
+ * 0176: the framework drops a surface in two steps: trap 4 while it still holds
+ * its client (detach: a later lookup must build a fresh view), trap 5 after it
+ * (release: unmap and drop the table user).  Mapping both to release, as the
+ * 0046 port did, removed the view under a lookup that ran between the two.
+ */
+IOReturn
+IOSurfaceRootUserClient::trapDetach(void *id, void *, void *, void *, void *, void *)
+{
+	uint32_t sid = (uint32_t)(uintptr_t)id;
+
+	IOLockLock(fLock);
+	SweetSurfaceRef *ref = findRef(sid, NULL);
+	if (ref != NULL) {
+		ref->detached = true;
+	}
+	IOLockUnlock(fLock);
+	sweet_trap_trace(4, sid, 0, 0, kIOReturnSuccess);
+	return kIOReturnSuccess;
+}
