 /*
+ * Wake the analogue front end, tune it, calibrate it, and route the host
+ * interrupt to the pad.
+ *
+ * Each of 0x91/0xa3/0xa4/0xa2 is a one-byte host command -- start, the
+ * address, the command, stop, and no register address -- because that is what
+ * i2c_smbus_write_byte() puts on the wire in the mainline driver, and the
+ * firmware answers each with an event in the FIFO. The waits are the ones in
+ * stmfts5_chip_runtime_resume.
+ */
+static void
+ftm5_wake_calibrate(void)
+{
+	static const struct {
+		uint8_t command;
+		const char *name;
+		uint32_t wait_ms;
+	} steps[] = {
+		{ FTM5_CMD_SLEEP_OUT,    "sleep out",         20 },
+		{ FTM5_CMD_MS_CX_TUNING, "mutual CX tuning",  20 },
+		{ FTM5_CMD_SS_CX_TUNING, "self CX tuning",    20 },
+		{ FTM5_CMD_FORCE_CAL,    "force calibration", 50 },
+	};
+	uint8_t host_int = FTM5_HOST_INT_ENABLE;
+	uint8_t host_int_back = 0;
+	bool ok;
+
+	for (unsigned i = 0; i < sizeof(steps) / sizeof(steps[0]); i++) {
+		ok = fts_write_bytes(&steps[i].command, 1);
+		printf("UMI TOUCH: FTM5 %s (%02x): %s\n", steps[i].name,
+		    steps[i].command, ok ? "acked" : "not acked");
+		umi_spin_ms(steps[i].wait_ms);
+	}
+	/*
+	 * Host interrupt enable: register 0x002C, value 0x01, written as
+	 * {0xB6, 0x00, 0x2C, 0x01} -- the same four bytes mainline sends
+	 * (int_enable_cmd). Reading it back uses the legacy read shape with its
+	 * dummy byte, so the value is a hint, not a verdict.
+	 */
+	ok = fts_write_registers_u16(FTM5_REG_HOST_INT, &host_int, 1);
+	(void)fts_read_registers_u16(FTM5_REG_HOST_INT, &host_int_back, 1);
+	printf("UMI TOUCH: FTM5 host interrupt 0x%04x <- 0x%02x: %s, read back %02x\n",
+	    FTM5_REG_HOST_INT, host_int, ok ? "acked" : "not acked", host_int_back);
+	umi_spin_ms(5);
+}
+
