--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -300,10 +300,24 @@
 	}
 	uint64_t now = mach_absolute_time();
 	uint64_t count = ++fb->fVsyncCount;
+	/*
+	 * IOMobileFramebufferVsyncNotifyFunc takes three 64-bit numbers, each split
+	 * into a low and a high 32-bit half, in this order:
+	 *
+	 *   [0..1] the refresh timestamp (mach_absolute_time of the vsync)
+	 *   [2..3] the timestamp the frame was presented
+	 *   [4..5] the vsync counter
+	 *
+	 * These were passed as counter, now, 0.  CoreAnimation reads [0..1] as the
+	 * timebase, so it was handed a counter that restarts at one and a zero
+	 * counter afterwards: its display link then derived a nonsense period and
+	 * stopped submitting frames after the first few.  The reference port spells
+	 * the layout out in UmiFramePacing.h (umi_fb_vsync_values).
+	 */
 	uint64_t values[6] = {
-		(uint32_t)count, (uint32_t)(count >> 32),
 		(uint32_t)now, (uint32_t)(now >> 32),
-		0, 0,
+		(uint32_t)now, (uint32_t)(now >> 32),
+		(uint32_t)count, (uint32_t)(count >> 32),
 	};
 
 	IOLockLock(fb->fLock);
