+		printf("UMI TOUCH: seq: 7) feature 03, gesture %02x %02x %02x %02x: %s\n",
+		    gesture[2], gesture[3], gesture[4], gesture[5],
+		    fts_write_bytes(gesture, sizeof(gesture)) ? "acked" : "not acked");
+	}
+	umi_spin_ms(20);
+	return true;
+}
