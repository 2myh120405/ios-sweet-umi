+/*
+ * umi_touch_crc=1: fts_crc_check (ftsCore.c:857), spelled out.
+ *
+ * The register read alone is not the verdict: ADDR_CRC & CRC_MASK names the
+ * area per the CRC_Error enum (1 code, 2 config, 3 cx), and the vendor then
+ * resets and looks in the FIFO for the error events that carry the area. The
+ * second half is the part that cannot be faked by a chip whose application is
+ * only half up, so it is the part worth reading.
+ */
+static void
+ftm5_crc_report(void)
+{
+	uint8_t crc = 0;
+	uint8_t dump[FTM5_ERROR_DUMP_SIZE];
+	bool ready = false;
+
+	if (!fts_read_registers(FTM5_ADDR_CRC, &crc, 1)) {
+		printf("UMI TOUCH: crc: ADDR_CRC 0x%08x not acknowledged\n", FTM5_ADDR_CRC);
+	} else {
+		printf("UMI TOUCH: crc: ADDR_CRC 0x%08x = %02x, status %u of CRC_MASK "
+		    "%02x (none when 0; fts_crc_check calls any non-zero CRC_CODE and "
+		    "tells the areas apart with the boot events)\n", FTM5_ADDR_CRC,
+		    crc, (unsigned)(crc & FTM5_CRC_MASK), FTM5_CRC_MASK);
+	}
+	ftm5_sysinfo_print();
+
+	if (reset_mode == 2) {
+		printf("UMI TOUCH: crc: reset skipped (umi_touch_reset=2): "
+		    "the events the boot left are already gone\n");
+	} else {
+		printf("UMI TOUCH: crc: reset, then the events the application reports at boot\n");
+		ftm5_reset_pulse();
+		for (unsigned i = 0; i < 100 && !ready; i++) {
+			uint8_t e[FTS_EVENT_SIZE];
+
+			if (!fts_read_events_ftm5(e, 1)) {
+				printf("UMI TOUCH: crc: the FIFO read was not acknowledged\n");
+				break;
+			}
+			if (e[0] == 0x00) {
+				umi_spin_ms(2);
+				continue;
+			}
+			ftm5_print_event("crc at boot", e);
+			ready = e[0] == FTM5_EVENTID_CONTROLLER_READY;
+		}
+		if (!ready) {
+			printf("UMI TOUCH: crc: no controller-ready event in 200 ms\n");
+		}
+		(void)ftm5_dump_fifo("crc after boot");
+	}
+
+	if (!fts_read_framebuffer(FTM5_ADDR_ERROR_DUMP, dump, sizeof(dump))) {
+		printf("UMI TOUCH: errdump: framebuffer 0x%04x not acknowledged\n",
+		    FTM5_ADDR_ERROR_DUMP);
+	} else if (ftm5_le32(dump) != FTM5_ERROR_DUMP_SIGNATURE) {
+		printf("UMI TOUCH: errdump: 0x%04x starts %08x, not %08x: nothing dumped\n",
+		    FTM5_ADDR_ERROR_DUMP, ftm5_le32(dump), FTM5_ERROR_DUMP_SIGNATURE);
+	} else {
+		printf("UMI TOUCH: errdump: 0x%04x signature ok\n", FTM5_ADDR_ERROR_DUMP);
+		ftm5_hex_dump("errdump", dump, sizeof(dump));
+	}
+}
+
+/*
+ * umi_touch_scantest=1: the same 0x86 read at three lengths and every byte
+ * printed, zeros included. 8 bytes is what pollForEvent asks for, 16 is two
+ * events, 80 is what a ten-event burst asks for. A chip that answers eight
+ * zeros has an empty FIFO; a chip that does not acknowledge the read address
+ * has nothing to say at all; a chip that answers data has events nobody is
+ * dispatching. The three are told apart here and nowhere else.
+ */
+static void
+ftm5_scan_test(void)
+{
+	static const uint32_t lengths[] = { 8, 16, 80 };
+	uint8_t buf[80];
+
+	for (unsigned l = 0; l < sizeof(lengths) / sizeof(lengths[0]); l++) {
+		uint32_t length = lengths[l];
+		unsigned nonzero = 0;
+		bool ok;
+
+		memset(buf, 0, sizeof(buf));
+		ok = fts_read_fifo_raw(buf, length);
+		for (uint32_t i = 0; ok && i < length; i++) {
+			if (buf[i] != 0) {
+				nonzero++;
+			}
+		}
+		printf("UMI TOUCH: scantest: 0x86 read of %u bytes: %s, %u byte(s) non-zero\n",
+		    (unsigned)length, ok ? "acked" : "NOT acked", nonzero);
+		if (ok) {
+			ftm5_hex_dump("scantest", buf, length);
+			if (nonzero) {
+				ftm5_print_event("scantest", buf);
+			}
+		}
+		umi_spin_ms(20);
+	}
+}
+
+static unsigned
+ftm5_hex_nibble(char c)
+{
+	if (c >= '0' && c <= '9') {
+		return (unsigned)(c - '0');
+	}
+	if (c >= 'a' && c <= 'f') {
+		return (unsigned)(c - 'a' + 10);
+	}
+	if (c >= 'A' && c <= 'F') {
+		return (unsigned)(c - 'A' + 10);
+	}
+	return 16;
+}
+
+/*
+ * umi_touch_regs=0x20000078,0x20000020: four bytes from each 32-bit hardware
+ * register named, through the 0xFA the chip id is read with. Hex, separated by
+ * commas or spaces, up to eight addresses.
+ */
+static void
+ftm5_dump_regs(const char *list)
+{
+	const char *p = list;
+	unsigned n = 0;
+
+	while (*p != '\0' && n < 8) {
+		uint32_t address = 0;
+		uint8_t data[4] = { 0, 0, 0, 0 };
+		unsigned digits = 0;
+
+		while (*p == ',' || *p == ' ') {
+			p++;
+		}
+		if (p[0] == '0' && (p[1] == 'x' || p[1] == 'X')) {
+			p += 2;
+		}
+		while (ftm5_hex_nibble(*p) < 16) {
+			address = (address << 4) | ftm5_hex_nibble(*p);
+			p++;
+			digits++;
+		}
+		while (*p != '\0' && *p != ',' && *p != ' ') {
+			p++;
+		}
+		if (digits == 0) {
+			break;
+		}
+		if (!fts_read_registers(address, data, sizeof(data))) {
+			printf("UMI TOUCH: regs: 0x%08x: not acknowledged\n", address);
+		} else {
+			printf("UMI TOUCH: regs: 0x%08x: %02x %02x %02x %02x (le %08x)\n",
+			    address, data[0], data[1], data[2], data[3],
+			    ftm5_le32(data));
+		}
+		n++;
+	}
+	if (n == 0) {
+		printf("UMI TOUCH: regs: \"%s\" names no address\n", list);
+	}
+}
+
+/*
+ * umi_touch_seq=1: fts_fw_update (fts.c:4906) and fts_init_sensing
+ * (fts.c:5302) in order, with the mainline wake block left out because the
+ * vendor has no such block at all:
+ *
+ *   1  readSysInfo(0)   0xA6 0x0000, 208 bytes                     ftsCore.c:499
+ *   2  fts_crc_check()  ADDR_CRC, then a reset and the boot events  ftsCore.c:857
