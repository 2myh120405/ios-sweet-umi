+/*
+ * ftsCore.c:85 fts_system_reset: with a reset pin on the board (st,reset-gpio
+ * = tlmm 38) the reset is a 10 ms low pulse, and only a board without one
+ * writes ADDR_SYSTEM_RESET 0x20000024 <- 0x80 instead. Either way the vendor
+ * then polls the FIFO for EVT_ID_CONTROLLER_READY (0x03), 100 ms per attempt
+ * and three attempts.
+ */
+static void
+ftm5_reset_pulse(void)
+{
+	gpio_output(PIN_RESET, false, PULL_NONE, 2);
+	umi_spin_ms(10);
+	gpio_output(PIN_RESET, true, PULL_NONE, 2);
+}
+
+/*
+ * ftsCore.c:499 readSysInfo and ftsError.c:76 dumpErrorInfo: 0xA6, a 16-bit
+ * address, no dummy byte. The same chip takes 0xFA with a 32-bit address for
+ * hardware registers and 0xA6 with a 16-bit one for the two memory windows, so
+ * the framing is per command, not per chip.
+ */
+static bool
+fts_read_framebuffer(uint16_t address, uint8_t *data, uint32_t length)
+{
+	bool ok;
+
+	memset(data, 0, length);
+	i2c_ack_reset();
+	i2c_start();
+	ok = i2c_write_byte((uint8_t)(I2C_ADDRESS << 1)) &&
+	    i2c_write_byte(FTM5_CMD_FRAMEBUFFER_R) &&
+	    i2c_write_byte((uint8_t)(address >> 8)) &&
+	    i2c_write_byte((uint8_t)(address & 0xff));
+	if (ok) {
+		i2c_start();
+		if (i2c_write_read_address()) {
+			for (uint32_t i = 0; i < length; i++) {
+				data[i] = i2c_read_byte(i + 1 < length);
+			}
+		} else {
+			ok = false;
+		}
+	}
+	i2c_stop();
+	return ok;
+}
+
+static uint16_t
+ftm5_le16(const uint8_t *p)
+{
+	return (uint16_t)(p[0] | (uint16_t)p[1] << 8);
+}
+
+static uint32_t
+ftm5_le32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | (uint32_t)p[1] << 8 | (uint32_t)p[2] << 16 |
+	    (uint32_t)p[3] << 24;
+}
+
+/* 16 bytes a line, for the error dump and umi_touch_scantest. */
+static void
+ftm5_hex_dump(const char *what, const uint8_t *data, uint32_t length)
+{
+	for (uint32_t i = 0; i < length; i += 16) {
+		printf("UMI TOUCH: %s %03x:", what, (unsigned)i);
+		for (uint32_t j = 0; j < 16 && i + j < length; j++) {
+			printf(" %02x", data[i + j]);
+		}
+		printf("\n");
+	}
+}
+
+/*
+ * The name of an event, out of ftsSoftware.h. The id is the top nibble of byte
+ * 0 -- the vendor's dispatcher indexes its table with event[0] >> 4 (fts.c:
+ * 4391) -- but 0x03 (CONTROLLER_READY) shares the nibble with 0x00 (NOEVENT),
+ * so the whole byte is checked first. For EVT_ID_ERROR byte 1 is the area that
+ * failed, which is the whole point of reading the FIFO after a reset.
+ */
+static const char *
+ftm5_event_name(const uint8_t *e)
+{
+	switch (e[0]) {
+	case 0x00: return "empty";
+	case FTM5_EVENTID_CONTROLLER_READY: return "controller ready";
+	}
+
+	switch (e[0] & FTM5_EVENTID_MASK) {
+	case 0x10: return "enter";
+	case 0x20: return "motion";
+	case 0x30: return "leave";
+	case 0x40:
+		if (e[1] == FTM5_STATUS_FRAME_DROP) {
+			return "status frame drop";
+		}
+		return "status";
+	case 0x50: return "user report";
+	case 0xe0: return "debug";
+	case 0xf0:
+		switch (e[1]) {
+		case 0x06: return "ERROR watchdog";
+		case 0x20: return "ERROR crc config head";
+		case 0x21: return "ERROR crc config";
+		case 0x22: return "ERROR crc panel head";
+		case 0x23: return "ERROR crc panel";
+		case 0xa0: return "ERROR crc cx head";
+		case 0xa1: return "ERROR crc cx";
+		case 0xa5: return "ERROR crc cx sub head";
+		case 0xa6: return "ERROR crc cx sub";
+		case 0xf0: return "ERROR esd";
+		default: return "ERROR other";
+		}
+	default: return "other";
+	}
+}
+
+static void
+ftm5_print_event(const char *when, const uint8_t *e)
+{
+	printf("UMI TOUCH: %s: event %02x %02x %02x %02x %02x %02x %02x %02x"
+	    " (%s, type %02x, queued %u)\n", when,
+	    e[0], e[1], e[2], e[3], e[4], e[5], e[6], e[7],
+	    ftm5_event_name(e), (unsigned)e[1], (unsigned)(e[7] & 0x1f));
+}
+
+/* Read events until the FIFO answers 0x00, printing every one of them. */
+static unsigned
+ftm5_dump_fifo(const char *when)
+{
+	uint8_t e[FTS_EVENT_SIZE];
+	unsigned n = 0;
+
+	for (; n < FTS_FIFO_DEPTH; n++) {
+		if (!fts_read_events_ftm5(e, 1)) {
+			printf("UMI TOUCH: %s: the FIFO read was not acknowledged after %u event(s)\n",
+			    when, n);
+			return n;
+		}
+		if (e[0] == 0x00) {
+			break;
+		}
+		ftm5_print_event(when, e);
+	}
+	if (n == 0) {
+		printf("UMI TOUCH: %s: no events\n", when);
+	}
+	return n;
+}
+
+/*
+ * ftsCore.c:499 readSysInfo: 208 bytes at framebuffer 0, byte 0 the header
+ * signature 0xA5 and byte 1 the data id 0x01, then little-endian fields in the
+ * order readSysInfo parses them. fts_fw_update decides with these whether to
+ * reflash, and whether the panel init data has to be reloaded.
+ */
+static uint8_t ftm5_sysinfo[FTM5_SYSINFO_SIZE];
+static bool ftm5_sysinfo_read;
+
+static bool
+ftm5_sysinfo_load(void)
+{
+	if (ftm5_sysinfo_read) {
+		return ftm5_sysinfo[0] == FTM5_HEADER_SIGNATURE;
+	}
+	ftm5_sysinfo_read = true;
+	if (!fts_read_framebuffer(0, ftm5_sysinfo, sizeof(ftm5_sysinfo))) {
+		printf("UMI TOUCH: sysinfo: framebuffer 0x0000 not acknowledged\n");
+		return false;
+	}
+	if (ftm5_sysinfo[0] != FTM5_HEADER_SIGNATURE ||
+	    ftm5_sysinfo[1] != FTM5_LOAD_SYS_INFO) {
+		printf("UMI TOUCH: sysinfo: header %02x/%02x, expected %02x/%02x: "
+		    "the application has not loaded it\n", ftm5_sysinfo[0],
+		    ftm5_sysinfo[1], FTM5_HEADER_SIGNATURE, FTM5_LOAD_SYS_INFO);
+		return false;
+	}
+	return true;
+}
+
+static void
+ftm5_sysinfo_print(void)
+{
+	const uint8_t *s = ftm5_sysinfo;
+
+	if (!ftm5_sysinfo_load()) {
+		return;
+	}
+	printf("UMI TOUCH: sysinfo: fw %04x svn %04x cfg %04x project %04x cx %04x "
+	    "project %04x\n", ftm5_le16(&s[16]), ftm5_le16(&s[18]),
+	    ftm5_le16(&s[20]), ftm5_le16(&s[22]), ftm5_le16(&s[24]),
+	    ftm5_le16(&s[26]));
+	printf("UMI TOUCH: sysinfo: afe cfg %02x cx %02x panel %02x, protocol %02x, "
+	    "%ux%u, tx %u rx %u key %u force %u\n", s[28], s[29], s[30], s[31],
+	    ftm5_le16(&s[80]), ftm5_le16(&s[82]), s[84], s[85], s[86], s[87]);
+	printf("UMI TOUCH: sysinfo: fw crc %08x cfg crc %08x, release %02x %02x %02x "
+	    "%02x %02x %02x %02x %02x%s\n", ftm5_le32(&s[64]),
+	    ftm5_le32(&s[68]), s[48], s[49], s[50], s[51], s[52], s[53], s[54],
+	    s[55], (s[28] == s[29] && s[28] == s[30]) ? "" :
+	    " -- AFE versions differ: fts_fw_update reloads the panel init");
+}
